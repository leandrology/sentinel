# Copy to .env (never commit .env)
# Simulator / ingestion (sensor simulator is opt-out by default)
SIMULATOR_URL=ws://localhost:8765
SIMULATOR_MIN_DELAY_S=30
SIMULATOR_MAX_DELAY_S=40
INGEST_ENABLED=false
INGEST_QUEUE_SIZE=500
INGEST_WORKERS=4
RECONNECT_BASE_S=1.0
RECONNECT_MAX_S=30.0

# Never commit real keys; copy to .env instead.
# Triage: AI_PROVIDER=mock (default) | gemini Gemini reuses GOOGLE_AI_* below.
AI_TIMEOUT_S=8.0
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT=8
AI_PROVIDER=mock

# Video
VIDEO_SOURCE=
VIDEO_SAMPLE_FPS=2.0
VIDEO_PREVIEW_FPS=15.0
VIDEO_FILE_REALTIME=true
VIDEO_MOTION_THRESHOLD=25.0
VIDEO_MIN_AREA=500.0
VIDEO_ENABLED=false
VIDEO_SITE_ID=site-100
VIDEO_ZONE=north-perimeter
VIDEO_UPLOAD_DIR=./data/uploads
VIDEO_MAX_MB=100

# Vision LLM (motion-gated keyframe analysis; final severity via triage + clamp)
VISION_PROVIDER=mock
VISION_ENABLED=true
VISION_COOLDOWN_S=10.0
VISION_MAX_CONCURRENT=2
VISION_TIMEOUT_S=15.0
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
TWELVELABS_API_KEY=
TWELVELABS_MODEL=marengo2.6
TWELVELABS_BASE_URL=https://api.twelvelabs.io

# Correlation
CORR_WINDOW_S=300
CORR_THRESHOLD=3

# App
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
PORT=8000
